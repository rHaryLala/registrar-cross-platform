APP_NAME="Registrar UAZ API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=registrar-crossplatform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications aux candidats (commande applications:notify). SMS_PROVIDER : journal (n'envoie rien) | twilio
SMS_ENABLED=true
SMS_PROVIDER=journal
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Registrar : développement local (voir README.md à la racine) ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Identifiant client OAuth Google (public). Doit autoriser http://localhost:3000 pour tester la connexion Google.
GOOGLE_CLIENT_ID=

# Connexion d'un étudiant avec le mot de passe de sa fiche (matricule ou e-mail), quand Google est indisponible.
# INTERRUPTEUR : false = coupé immédiatement.
REGISTRAR_STUDENT_PASSWORD_LOGIN=true
# Combien d'étudiants peuvent porter le MÊME mot de passe avant qu'il soit refusé (1 = un mot de passe commun à 2 étudiants
# ou plus est refusé ; 0 = aucune limite : DÉCONSEILLÉ, voir README « Connexion étudiante par la fiche »).
REGISTRAR_STUDENT_PASSWORD_MAX_SHARING=1
# Dossier des photos d'étudiants de l'ANCIENNE application (lecture seule). En production : app/photosetudiants du dépôt ancien.
# Par défaut (ligne absente) : ../../registrar/app/photosetudiants, le poste de développement. Ne pas laisser la valeur VIDE.
#STUDENT_PHOTOS_PATH=/var/www/registrar/app/photosetudiants
# Images des annonces (ANCIENNE application, lecture seule). Même règle : ne pas laisser la valeur vide.
#ANNOUNCEMENT_IMAGES_PATH=/var/www/registrar/app/uploads/annonces
# Synchronisation des actualités avec le site public (php artisan news:sync, planifiée toutes les 30 min : cron `* * * * * php artisan schedule:run`).
#SITE_NEWS_BASE=https://zurcher.edu.mg

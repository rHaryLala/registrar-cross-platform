<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Base MySQL de test : copie du SCHÉMA de production (structure seule), jamais de vraies données. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="localhost"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="registrar-crossplatform_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000"/>
        <env name="GOOGLE_CLIENT_ID" value="test-client-id"/>
        <!-- Réglages de sécurité FIXÉS pour les tests : un .env local (ex. test avec la règle des mots de passe communs levée) ne doit jamais les changer. -->
        <env name="REGISTRAR_STUDENT_PASSWORD_LOGIN" value="true" force="true"/>
        <env name="REGISTRAR_STUDENT_PASSWORD_MAX_SHARING" value="1" force="true"/>
        <env name="REGISTRAR_ZERO_COUNTS" value="false" force="true"/>
        <env name="STUDENT_PHOTOS_PATH" value="C:/dossier-de-photos-inexistant" force="true"/>
        <env name="SITE_NEWS_DELAY_MS" value="0" force="true"/>
        <env name="SITE_NEWS_BASE" value="https://zurcher.edu.mg" force="true"/>
        <env name="ANNOUNCEMENT_IMAGES_PATH" value="C:/dossier-d-images-inexistant" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

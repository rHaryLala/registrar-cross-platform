# Exemple de variables de PRODUCTION (non testé). Ne jamais committer le vrai .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://registrar.zurcher.edu.mg
APP_KEY=                       # php artisan key:generate --show

DB_CONNECTION=mysql
DB_HOST=127.0.0.1              # la base est sur la même machine que PHP-FPM
DB_PORT=3306
DB_DATABASE=                   # base existante (la même que l'ancien PHP)
DB_USERNAME=                   # utilisateur DÉDIÉ à l'API, droits limités
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=600
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=registrar.zurcher.edu.mg
CORS_ALLOWED_ORIGINS=          # vide : même origine, pas de CORS

GOOGLE_CLIENT_ID=              # identifiant public de l'application OAuth (doit autoriser registrar.zurcher.edu.mg)
CACHE_STORE=file
QUEUE_CONNECTION=sync          # passera à « database » avec le worker (notifications, création de comptes Google)
LOG_LEVEL=warning

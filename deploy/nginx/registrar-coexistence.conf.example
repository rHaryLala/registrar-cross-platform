# À AJOUTER dans le bloc `server { ... }` EXISTANT de registrar.zurcher.edu.mg (ne remplace rien).
# Exemple non testé. Tout le reste continue vers l'ancien PHP (location / existante).

# --- API Laravel : /api/v1/* ---
location ^~ /api/v1/ {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/registrar-api/public/index.php;
    fastcgi_param SCRIPT_NAME     /index.php;
    fastcgi_param REQUEST_URI     $request_uri;
    fastcgi_pass  unix:/run/php/php8.3-fpm-registrar-api.sock;   # pool dédié
}

# --- Nouvelle application (export statique de Next.js, basePath /app) ---
location ^~ /app/ {
    alias /var/www/registrar-app/;
    try_files $uri $uri.html $uri/index.html /app/index.html;    # SPA : retombe sur l'accueil
    add_header Cache-Control "no-cache";
}
# Fichiers à empreinte : jamais modifiés sous la même adresse, donc cache d'un an.
location ^~ /app/_next/static/ {
    alias /var/www/registrar-app/_next/static/;
    add_header Cache-Control "public, max-age=31536000, immutable";
}
